const express = require('express');
const dotenv = require('dotenv');
const connectDB = require('./src/config/database');

// Load env vars
dotenv.config();

const app = express();

// Body parser
app.use(express.json());

// Connect to database
connectDB();

// Create a test router if real ones fail
const testRouter = express.Router();
testRouter.get('/test', (req, res) => res.json({ message: 'Test route works!' }));

// Use routers with error handling
try {
  const authRoutes = require('./src/routes/authRoutes');
  app.use('/api/auth', authRoutes);
  console.log('✅ Auth routes loaded');
} catch (error) {
  console.log('⚠️  Auth routes not loaded, using test route instead:', error.message);
  app.use('/api/auth', testRouter);
}

// Use basic routers for other paths to avoid crashes
app.use('/api/parking', testRouter);
app.use('/api/admin', testRouter);
app.use('/api/projects', testRouter);

// Basic route
app.get('/', (req, res) => {
  res.json({
    project: "Smart Parking System",
    student: "Tenzing Kunsang Sherpa",
    group: "L6CG4",
    supervisor: "Adhish Suwal",
    academicYear: "2025/2026",
    status: "API is running (Test Mode)"
  });
});

// Test DB route
app.get('/test-db', (req, res) => {
  const mongoose = require('mongoose');
  const dbStatus = mongoose.connection.readyState;
  const statusText = dbStatus === 1 ? 'connected' : 'disconnected';
  res.json({ success: true, database: statusText });
});

const PORT = process.env.PORT || 5001;

app.listen(PORT, () => {
  console.log('\n' + '='.repeat(60));
  console.log('�� SMART PARKING SYSTEM BACKEND (Test Mode)');
  console.log('='.repeat(60));
  console.log(`📡 Server: http://localhost:${PORT}`);
  console.log('='.repeat(60));
});
