# --- Required ---
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/smartpark
JWT_SECRET=replace-with-a-long-random-string

# --- Recommended ---
QR_SIGNING_SECRET=replace-with-another-long-random-string
QR_ALLOW_LEGACY=true             # set false after all clients have re-issued signed QRs
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Payments (Khalti) ---
KHALTI_SECRET_KEY=
KHALTI_MODE=test

# --- Email (Ethereal fallback used when these are blank) ---
EMAIL_USER=
EMAIL_PASS=

# --- Rate limiting (optional overrides) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Seeder ---
SEED_ADMIN_EMAIL=admin@smartpark.com
SEED_ADMIN_PASSWORD=Admin@1234   # required when NODE_ENV=production
