PORT=5001

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
NODE_ENV=development

# Email Service (Gmail)
# If EMAIL_USER + EMAIL_PASS are set, mail goes to real inboxes (even when NODE_ENV=development).
# If omitted, the server uses Ethereal (fake inbox) — good for local dev without Gmail.
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password_here
# Note: Use Gmail App Password, not your regular password (2FA must be on).
# Generate at: https://myaccount.google.com/apppasswords

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Khalti Payment
KHALTI_SECRET_KEY=your_khalti_secret_key
KHALTI_PUBLIC_KEY=your_khalti_public_key
